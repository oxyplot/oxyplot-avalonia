<Window 
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AvaloniaExamples.Examples.ScatterDemo" 
        xmlns:oxy="clr-namespace:OxyPlot.Avalonia;assembly=OxyPlot.Avalonia" 
        x:Class="AvaloniaExamples.Examples.ScatterDemo.MainWindow"
        Title="ScatterDemo" Height="480" Width="640"
        x:DataType="local:Context">
    <Grid>
        <oxy:PlotView Model="{Binding ScatterModel}"/>
    </Grid>
</Window>
